---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<Base title="Página não encontrada | Korza" description="Essa página saiu do ar. Volte para a página inicial da Korza ou crie sua conta." noindex>
  <Nav />
  <main id="conteudo" class="section">
    <div class="container nf">
      <p class="eyebrow">Erro 404</p>
      <h1 class="h1">Essa página saiu do ar.</h1>
      <p class="lead">O app da sua loja, não. Volte para a página inicial ou crie sua conta.</p>
      <div class="nf__ctas">
        <a class="btn btn--ghost btn--lg" href="/">Voltar ao início</a>
        <a class="btn btn--primary btn--lg" href={site.cta}>{site.ctaLabel}<Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </main>
  <Footer />
</Base>
<style>
  .nf { display: grid; gap: 1.5rem; justify-items: start; max-width: 44rem; min-height: 50vh; align-content: center; }
  .nf__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
