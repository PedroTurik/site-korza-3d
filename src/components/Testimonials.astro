---
import { cases } from '../data/content';
const items = cases.testimonials;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="testi section" id="depoimentos" aria-labelledby="testi-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Depoimentos</p>
      <h2 class="h2" id="testi-title">Quem lançou, <span class="accent">recomenda.</span></h2>
    </div>

    <div class="stage" data-stage data-reveal style="--d:120ms">
      {items.map((t, i) => (
        <article class="stage__panel" id={`testi-panel-${i}`} role="tabpanel" aria-labelledby={`testi-tab-${i}`} hidden={i !== 0} data-panel>
          <div class="stage__portrait">
            <span class="stage__block" aria-hidden="true"></span>
            <img src={t.photo} alt={`${t.name}, ${t.role}`} width="320" height="320" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
          </div>
          <div class="stage__quote">
            <img class="stage__wordmark" src={t.wordmark} alt={t.brand} height="32" loading="lazy" decoding="async" />
            <span class="stage__mark" aria-hidden="true">“</span>
            <blockquote><p>{t.quote}</p></blockquote>
            <footer>
              <b>{t.name}</b>
              <span class="small muted">{t.role}</span>
            </footer>
          </div>
        </article>
      ))}
    </div>

    <div class="tabs" role="tablist" aria-label="Escolher depoimento" data-reveal style="--d:200ms">
      {items.map((t, i) => (
        <button type="button" role="tab" id={`testi-tab-${i}`} class="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`testi-panel-${i}`} tabindex={i === 0 ? 0 : -1} data-tab>
          <span class="tab__index">{pad(i + 1)}</span>
          <img src={t.photo} alt="" width="52" height="52" loading="lazy" decoding="async" />
          <span class="tab__who"><b>{t.name}</b><span>{t.brand}</span></span>
        </button>
      ))}
    </div>
  </div>
</section>

<style>
  .testi { background: var(--paper-2); }
  .stage { position: relative; margin-top: 3.5rem; }
  .stage__panel { display: grid; gap: 2.5rem; }
  @media (min-width: 64em) { .stage__panel { grid-template-columns: 5fr 7fr; gap: 5rem; align-items: center; } }
  .stage__panel[hidden] { display: none; }
  .stage__panel.is-leaving { opacity: 0; transition: opacity 0.4s var(--ease); }
  .stage__panel.is-entering { animation: fade-in 0.4s var(--ease) both; }
  @keyframes fade-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  .stage__portrait { position: relative; padding: 0 1.25rem 1.25rem 0; }
  .stage__portrait img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center top; position: relative; z-index: 1; }
  .stage__block { position: absolute; inset: 1.25rem 0 0 1.25rem; background: var(--blue); }

  .stage__quote { display: grid; gap: 1.25rem; align-content: center; justify-items: start; }
  .stage__wordmark { height: 2rem; width: auto; max-width: 12rem; object-fit: contain; object-position: left center; }
  .stage__mark { font-size: 5rem; line-height: 0.6; font-weight: 500; color: var(--blue); letter-spacing: var(--track); margin-top: 0.5rem; }
  .stage__quote blockquote p { font-size: var(--fs-h3); font-weight: 500; letter-spacing: var(--track-snug); line-height: 1.3; color: var(--ink); max-width: 30rem; text-wrap: pretty; }
  .stage__quote footer { display: grid; gap: 0.15rem; margin-top: 0.5rem; }
  .stage__quote footer b { font-weight: 500; }

  .tabs { display: grid; gap: 1px; margin-top: 3.5rem; border-top: 1px solid var(--line); }
  @media (min-width: 48em) { .tabs { grid-template-columns: repeat(3, 1fr); } }
  .tab { display: flex; align-items: center; gap: 1rem; padding: 1.25rem 0.25rem 0; text-align: left; color: var(--ink-500); position: relative; transition: color 0.25s; }
  .tab::before { content: ''; position: absolute; top: -1px; left: 0; right: 0; height: 2px; background: var(--blue); transform: scaleX(0); transform-origin: left; transition: transform 0.4s var(--ease); }
  .tab[aria-selected="true"] { color: var(--ink); }
  .tab[aria-selected="true"]::before { transform: scaleX(1); }
  .tab:hover { color: var(--ink); }
  .tab__index { font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.08em; font-variant-numeric: tabular-nums; width: 1.5rem; }
  .tab img { width: 3.25rem; height: 3.25rem; border-radius: 50%; object-fit: cover; filter: grayscale(1); transition: filter 0.3s; }
  .tab[aria-selected="true"] img, .tab:hover img { filter: none; }
  .tab__who { display: grid; line-height: 1.3; }
  .tab__who b { font-weight: 500; }
  .tab__who span { font-size: var(--fs-small); }

  @media (max-width: 64em) {
    .stage { margin-top: 2.5rem; }
    .stage__portrait { max-width: 20rem; }
    .stage__portrait img { max-height: 24rem; }
    .stage__quote blockquote p { font-size: 1.25rem; }
    .stage__mark { font-size: 4rem; }
    .tabs { margin-top: 2.5rem; }
    .tab { padding-top: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  }
</style>

<script>
  const root = document.getElementById('depoimentos')!;
  const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
  const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let active = 0, timer = 0, busy = false;

  const show = (i: number, focus = false) => {
    if (i === active || busy) return;
    const from = panels[active], to = panels[i];
    tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
    const swap = () => {
      from.hidden = true; from.classList.remove('is-leaving');
      to.hidden = false; to.classList.add('is-entering');
      to.addEventListener('animationend', () => to.classList.remove('is-entering'), { once: true });
      busy = false;
    };
    if (reduce) { from.hidden = true; to.hidden = false; }
    else { busy = true; from.classList.add('is-leaving'); setTimeout(swap, 400); }
    active = i;
    if (focus) tabs[i].focus();
  };

  tabs.forEach((t, i) => {
    t.addEventListener('click', () => { show(i); restart(); });
    t.addEventListener('keydown', (e) => {
      const n = tabs.length;
      if (e.key === 'ArrowRight') { e.preventDefault(); show((active + 1) % n, true); restart(); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show((active - 1 + n) % n, true); restart(); }
      if (e.key === 'Home') { e.preventDefault(); show(0, true); restart(); }
      if (e.key === 'End') { e.preventDefault(); show(n - 1, true); restart(); }
    });
  });

  const stop = () => { clearInterval(timer); timer = 0; };
  const start = () => { if (reduce || timer) return; timer = window.setInterval(() => show((active + 1) % panels.length), 7000); };
  const restart = () => { stop(); start(); };
  root.addEventListener('mouseenter', stop);
  root.addEventListener('mouseleave', start);
  root.addEventListener('focusin', stop);
  root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget as Node)) start(); });
  document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  start();
</script>
