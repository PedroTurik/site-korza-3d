---
import { features } from '../data/content';
import Icon from './Icon.astro';
const platforms = ['shopify', 'nuvemshop', 'woocommerce', 'tray', 'yampi', 'vtex'];
const pushes = [
  { icon: 'belletonn', name: 'Belletonn', text: 'Um mimo para quem já é de casa…' },
  { icon: 'd1-fitness', name: 'D1 Fitness', text: 'Últimas horas do seu benefício…' },
  { icon: 'sunkids', name: 'Sunkids', text: 'Que saudade de você ❤️…' },
];
/* ILUSTRATIVO — consolidar em content.ts */
const demo = {
  pushesMonth: 12480,          // "envios este mês" no tile de push
  syncedProducts: 1248,        // produtos sincronizados no tile de integração
  checkoutBefore: '223,41',    // total antes do cupom
  checkoutAfter: 189.9,        // total depois do cupom (count-up)
  salesApp: 100786,            // vendas pelo app no tile de analytics
  rebuys: 131,
  rebuyPct: 40,
};
const seals = ['Publicação inclusa', 'Atualizações inclusas', 'Time Korza no lançamento'];
const byId = Object.fromEntries(features.items.map((f) => [f.id, f]));
const rd = 42, circ = 2 * Math.PI * rd;
---
<section class="feat section" id="funcionalidades" aria-labelledby="feat-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow" data-reveal>{features.eyebrow}</p>
      <h2 class="h2" id="feat-title" data-reveal style="--d:60ms">{features.h2a} <span class="accent">{features.h2b}</span></h2>
    </div>

    <ul class="bento">
      <!-- push -->
      <li class="tile tile--push panel panel--ink" data-reveal data-scene>
        <div class="vis vis--push" aria-hidden="true">
          <span class="inf">∞ envios · <b data-count={demo.pushesMonth} data-delay="500">12.480</b> este mês</span>
          <ul class="stack">
            {pushes.map((p, i) => (
              <li class="notif slide-in" style={`--d:${150 + i * 260}ms`}><img src={`/clients/${p.icon}.webp`} alt="" width="32" height="32" loading="lazy" decoding="async" /><div><b>{p.name} <span>agora</span></b><p>{p.text}</p></div></li>
            ))}
          </ul>
        </div>
        <div class="cap"><h3>{byId.push.title}</h3><p class="muted">{byId.push.text}</p></div>
      </li>

      <!-- sync -->
      <li class="tile tile--sync panel" data-reveal style="--d:60ms" data-scene>
        <div class="vis vis--sync" aria-hidden="true">
          <ul class="plats">{platforms.map((p, i) => <li class="pop" style={`--d:${i * 60}ms`}><img src={`/integrations/${p}.svg`} alt="" height="14" loading="lazy" decoding="async" /></li>)}</ul>
          <svg class="wires" viewBox="0 0 80 120" fill="none" stroke="#b9c3d6" stroke-width="1" stroke-dasharray="3 3" preserveAspectRatio="none"><path class="flow" d="M0 20 C30 20 30 60 50 60"/><path class="flow" d="M0 60 H50"/><path class="flow" d="M0 100 C30 100 30 60 50 60"/><path class="flow" d="M50 60 H80"/></svg>
          <span class="hub pop" style="--d:300ms"><img src="/brand/korza-mark.svg" alt="" width="22" height="19" /></span>
          <svg class="wires wires--r" viewBox="0 0 60 120" fill="none" stroke="#b9c3d6" stroke-width="1" stroke-dasharray="3 3" preserveAspectRatio="none"><path class="flow" d="M0 60 C25 60 25 35 60 35"/><path class="flow" d="M0 60 C25 60 25 85 60 85"/></svg>
          <ul class="stores">
            <li class="pop" style="--d:520ms"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M16.4 12.7c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1.9-4 2.4-1.7 2.9-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.3 1.3-2.6 1.3-2.7 0 0-2.6-1-2.6-3.9ZM14 5.5c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.8-1.5Z"/></svg></li>
            <li class="pop" style="--d:620ms"><svg viewBox="0 0 24 24"><path fill="#00D7FE" d="M3.6 2.4c-.3.3-.5.8-.5 1.4v16.4c0 .6.2 1.1.5 1.4l9.2-9.6-9.2-9.6Z"/><path fill="#00F076" d="m15.9 15.1-3.1-3.1-9.2 9.6c.5.5 1.3.5 2.2 0l10.1-6.5Z"/><path fill="#FFC900" d="m20 9.7-3.1-1.8-3 3.1 3.1 3.1 3-1.8c1.4-.8 1.4-1.9 0-2.6Z"/><path fill="#F43249" d="M5.8 2.4 15.9 8.9l-3.1 3.1L3.6 2.4c.5-.5 1.3-.5 2.2 0Z"/></svg></li>
          </ul>
          <p class="live"><span class="live__count"><b data-count={demo.syncedProducts} data-delay="700" data-dur="1600">1.248</b> produtos sincronizados</span><span class="live__dots"><i class="ui-dot pop" style="--d:900ms"></i>estoque <i class="ui-dot pop" style="--d:1050ms"></i>preço <i class="ui-dot pop" style="--d:1200ms"></i>produtos</span></p>
        </div>
        <div class="cap"><h3>{byId.sync.title}</h3><p class="muted">{byId.sync.text}</p></div>
      </li>

      <!-- trio: horizontal scroller on mobile, three grid tiles on desktop -->
      <li class="trio"><ul class="trio__track">
        <!-- checkout -->
        <li class="tile tile--checkout panel" data-reveal data-scene>
          <div class="vis vis--checkout" aria-hidden="true">
            <div class="ui chk">
              <p class="chk__t">Pagamento</p>
              <ul>
                <li><span><i class="ui-dot ok"></i>Pix</span><b>aprovado</b></li>
                <li><span>Frete</span><b>grátis</b></li>
                <li class="chk__coupon pop" style="--d:700ms"><span><Icon name="tag" size={11} /> Cupom VOLTEI</span><b>−15%</b></li>
              </ul>
              <p class="chk__total"><span>Total</span><span class="chk__vals"><s>R$ {demo.checkoutBefore}</s><b>R$ <span data-count={demo.checkoutAfter} data-dec="2" data-delay="1000" data-dur="900">189,90</span></b></span></p>
              <span class="ui-btn chk__btn">Finalizar compra</span>
            </div>
            <span class="tag tag--soft same pop" style="--d:200ms">Mesmo do site</span>
          </div>
          <div class="cap"><h3>{byId.checkout.title}</h3><p class="muted">{byId.checkout.text}</p></div>
        </li>

        <!-- brand -->
        <li class="tile tile--brand panel" data-reveal style="--d:60ms" data-scene>
          <div class="vis vis--brand" aria-hidden="true">
            <ul class="icons">
              {['loum', 'pe-de-algodao', 'belletonn'].map((c, i) => <li class="pop" style={`--d:${i * 140}ms`}><img src={`/clients/${c}.webp`} alt="" width="56" height="56" loading="lazy" decoding="async" /></li>)}
            </ul>
            <ul class="palette"><li class="pop" style="--c:#5a3d2b; --d:450ms"></li><li class="pop" style="--c:#f0a6b9; --d:550ms"></li><li class="pop" style="--c:#155dfc; --d:650ms"></li><span class="palette__ring"></span></ul>
            <p class="tiny">Sua paleta, seu logo</p>
          </div>
          <div class="cap"><h3>{byId.brand.title}</h3><p class="muted">{byId.brand.text}</p></div>
        </li>

        <!-- banner -->
        <li class="tile tile--banner panel" data-reveal style="--d:120ms" data-scene>
          <div class="vis vis--banner" aria-hidden="true">
            <div class="ui browser">
              <div class="browser__bar"><i></i><i></i><i></i></div>
              <div class="browser__slot"><div class="browser__banner slide-in" style="--d:350ms"><span>Baixe o app e ganhe <b>10% OFF</b></span><em>Baixar</em></div></div>
              <div class="browser__page">
                <div class="wf wf--nav"></div>
                <div class="wf wf--hero"></div>
                <div class="wf__row"><div class="wf"></div><div class="wf"></div><div class="wf"></div></div>
              </div>
            </div>
          </div>
          <div class="cap"><h3>{byId.banner.title}</h3><p class="muted">{byId.banner.text}</p></div>
        </li>
      </ul></li>

      <!-- analytics -->
      <li class="tile tile--analytics panel" data-reveal data-scene>
        <div class="vis vis--analytics" aria-hidden="true">
          <div class="kpi">
            <span class="ui__label">Vendas pelo app</span>
            <b>R$ <span data-count={demo.salesApp} data-delay="300" data-dur="1400">100.786</span></b>
            <svg viewBox="0 0 160 40" preserveAspectRatio="none"><polyline class="draw" style="--d:200ms" pathLength="1" fill="none" stroke="#155dfc" stroke-width="1.5" vector-effect="non-scaling-stroke" points="0,34 16,30 32,31 48,20 64,24 80,13 96,17 112,9 128,14 144,5 160,8"/></svg>
          </div>
          <div class="kpi kpi--mid"><span class="ui__label">Recompras</span><b data-count={demo.rebuys} data-delay="500">131</b><p>últimos 30 dias</p></div>
          <div class="kpi kpi--donut">
            <svg viewBox="0 0 100 100"><circle cx="50" cy="50" r={rd} fill="none" stroke="#e6e8ee" stroke-width="9"/><circle class="arc" cx="50" cy="50" r={rd} fill="none" stroke="#155dfc" stroke-width="9" stroke-dasharray={`${(circ * demo.rebuyPct) / 100} ${circ}`} stroke-dashoffset={circ} style={`--off:0; --d:400ms`} transform="rotate(-90 50 50)"/><text x="50" y="54" text-anchor="middle" font-size="18" font-weight="500" fill="#0b0f19"><tspan data-count={demo.rebuyPct} data-delay="400" data-dur="1100">40</tspan>%</text></svg>
            <span class="ui__label">recompras</span>
          </div>
        </div>
        <div class="cap"><h3>{byId.analytics.title}</h3><p class="muted">{byId.analytics.text}</p></div>
      </li>
    </ul>

    <ul class="seals" data-reveal aria-label="Incluso em todos os planos">
      {seals.map((s) => <li><Icon name="check" size={16} />{s}</li>)}
    </ul>
  </div>
</section>

<style>
  .bento { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; margin-top: clamp(2.5rem, 5vw, 4rem); }
  .trio, .trio__track { display: contents; }
  @media (min-width: 48em) { .bento { grid-template-columns: repeat(12, 1fr); } .tile { grid-column: span 6; } .tile--analytics { grid-column: span 12; } }
  @media (min-width: 64em) {
    .tile--push { grid-column: span 7; } .tile--sync { grid-column: span 5; }
    .tile--checkout, .tile--brand, .tile--banner { grid-column: span 4; }
  }
  .tile { display: grid; grid-template-rows: 1fr auto; gap: 1.25rem; padding: 1.75rem; min-height: 22rem; }
  .tile--analytics { min-height: 0; }
  .cap { display: grid; gap: 0.2rem; }
  .cap h3 { font-size: 1.125rem; font-weight: 500; letter-spacing: var(--track-snug); }
  .cap p { font-size: 0.9rem; }
  .vis { position: relative; display: grid; align-content: center; min-height: 0; }
  .ui__label { font-size: 0.6rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-500); }

  /* push */
  .vis--push { padding-top: 1.5rem; }
  .inf { position: absolute; top: 0; right: 0; font-size: 0.7rem; font-weight: 600; color: #8fb1ff; letter-spacing: 0.04em; }
  .inf b { font-weight: 600; color: #fff; }
  .stack { display: grid; gap: 0.5rem; max-width: 22rem; }
  .notif { display: grid; grid-template-columns: 2rem 1fr; gap: 0.6rem; align-items: center; padding: 0.65rem 0.75rem; border-radius: 14px; background: rgb(255 255 255 / 0.14); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border: 1px solid rgb(255 255 255 / 0.12); font-size: 0.74rem; line-height: 1.3; color: #fff; }
  .notif img { width: 2rem; height: 2rem; border-radius: 8px; }
  .notif b { display: flex; justify-content: space-between; font-weight: 500; }
  .notif b span { opacity: 0.55; font-weight: 400; }
  .notif p { opacity: 0.8; }
  .notif:nth-child(1) { --x: -0.5rem; --r: -1deg; }
  .notif:nth-child(3) { --x: 0.75rem; --r: 1deg; }
  .notif.slide-in { transform: translate(var(--x, 0), -16px) rotate(var(--r, 0deg)); }
  .is-on .notif.slide-in { transform: translate(var(--x, 0), 0) rotate(var(--r, 0deg)); }

  /* sync */
  .vis--sync { display: grid; grid-template-columns: auto 1fr auto 1fr auto; align-items: center; gap: 0; }
  .plats { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; }
  .plats li { display: grid; place-items: center; width: 3rem; height: 1.9rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-sm); }
  .plats img { height: 0.7rem; width: auto; max-width: 2.2rem; filter: grayscale(1) opacity(0.6); }
  .wires { width: 100%; height: 7.5rem; }
  .flow { stroke-dashoffset: 0; }
  .is-on .flow { animation: flow 1.4s linear infinite; }
  .is-on .wires--r .flow { animation-delay: 0.7s; }
  @keyframes flow { to { stroke-dashoffset: -12; } }
  .hub { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; background: var(--blue); border-radius: var(--radius-sm); box-shadow: 0 12px 28px -12px rgb(21 93 252 / 0.6); }
  .hub img { filter: brightness(0) invert(1); width: 1.4rem; }
  .stores { display: grid; gap: 0.9rem; }
  .stores li { width: 2.25rem; height: 2.25rem; display: grid; place-items: center; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-sm); color: var(--ink); }
  .stores svg { width: 1.1rem; height: 1.1rem; }
  .live { grid-column: 1 / -1; margin-top: 0.75rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.4rem 1rem; align-items: center; font-size: 0.68rem; color: var(--ink-500); }
  .live__count b { font-weight: 500; color: var(--ink); }
  .live__dots { display: inline-flex; align-items: center; gap: 0.5rem; }
  .live .ui-dot { background: #12b76a; margin-right: -0.2rem; }

  /* trio → horizontal scroller on small screens */
  @media (max-width: 47.99em) {
    .trio { display: block; margin-inline: calc(-1 * var(--gutter)); }
    .trio__track { display: flex; gap: 0.75rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-inline: var(--gutter); padding-bottom: 0.25rem; }
    .trio__track::-webkit-scrollbar { display: none; }
    .trio__track > .tile { flex: 0 0 84%; scroll-snap-align: start; min-height: 20rem; }
  }

  /* checkout */
  .vis--checkout { place-items: center; }
  .chk { width: min(100%, 15rem); padding: 1rem; display: grid; gap: 0.6rem; }
  .chk__t { font-weight: 500; font-size: 0.85rem; letter-spacing: var(--track-snug); }
  .chk ul { display: grid; }
  .chk li { display: flex; justify-content: space-between; padding: 0.4rem 0; border-top: 1px solid var(--line); color: var(--ink-500); }
  .chk li span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .chk li b { font-weight: 500; color: var(--ink); }
  .chk__coupon { color: var(--blue-700); }
  .chk__coupon span { color: var(--blue-700); }
  .chk__coupon b { color: var(--blue-700); }
  .ok { background: #12b76a; }
  .chk__total { display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 0.5rem; align-items: baseline; }
  .chk__vals { display: inline-flex; gap: 0.45rem; align-items: baseline; }
  .chk__vals s { color: var(--ink-400); font-size: 0.66rem; opacity: 0; transition: opacity 0.4s var(--ease) 1000ms; }
  .is-on .chk__vals s { opacity: 1; }
  .chk__total b { font-weight: 500; font-size: 0.9rem; }
  .chk__btn { background: var(--ink); width: 100%; }
  .same { position: absolute; top: 0.25rem; right: 0; }

  /* brand */
  .vis--brand { justify-items: center; gap: 1rem; }
  .icons { display: flex; gap: 0.75rem; }
  .icons img { width: 3.5rem; height: 3.5rem; border-radius: 22%; box-shadow: 0 10px 24px -14px rgb(11 15 25 / 0.5); }
  .palette { position: relative; display: flex; gap: 0.35rem; }
  .palette li { width: 2.6rem; height: 0.6rem; background: var(--c); border-radius: var(--radius-xs); }
  .palette__ring { position: absolute; top: -0.2rem; left: -0.2rem; width: 3rem; height: 1rem; border: 1.5px solid var(--ink); border-radius: 3px; opacity: 0; }
  .is-on .palette__ring { animation: ring 1.6s var(--ease) 1000ms forwards; }
  @keyframes ring { 0% { opacity: 0; transform: translateX(0); } 12% { opacity: 1; } 45% { transform: translateX(0); } 60% { transform: translateX(2.95rem); } 85% { transform: translateX(5.9rem); opacity: 1; } 100% { transform: translateX(5.9rem); opacity: 1; } }
  .tiny { font-size: 0.68rem; color: var(--ink-500); }

  /* banner */
  .vis--banner { place-items: center; }
  .browser { width: min(100%, 16rem); }
  .browser__bar { display: flex; gap: 0.3rem; padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--line); }
  .browser__bar i { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--line-strong); }
  .browser__slot { overflow: hidden; }
  .browser__banner { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; padding: 0.5rem 0.6rem; background: var(--blue); color: #fff; font-size: 0.64rem; }
  .browser__banner.slide-in { transform: translateY(-100%); }
  .is-on .browser__banner.slide-in { transform: none; }
  .browser__banner b { font-weight: 600; }
  .browser__banner em { font-style: normal; padding: 0.25rem 0.5rem; background: #fff; color: var(--blue); border-radius: var(--radius-xs); font-weight: 600; }
  .browser__page { padding: 0.6rem; display: grid; gap: 0.45rem; }
  .wf { background: var(--paper-3); border-radius: var(--radius-xs); height: 2.2rem; }
  .wf--nav { height: 0.6rem; width: 60%; }
  .wf--hero { height: 3.4rem; }
  .wf__row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.45rem; }

  /* analytics */
  .vis--analytics { grid-template-columns: 1fr; gap: 1.5rem; min-height: 7rem; }
  @media (min-width: 48em) { .vis--analytics { grid-template-columns: 1.4fr 1fr auto; align-items: center; } .tile--analytics { grid-template-rows: auto; grid-template-columns: 1fr auto; align-items: center; gap: 2rem; } .tile--analytics .cap { max-width: 14rem; } }
  .kpi { display: grid; gap: 0.25rem; }
  .kpi b { font-size: 1.75rem; font-weight: 500; letter-spacing: var(--track); line-height: 1; }
  .kpi svg { width: 100%; max-width: 14rem; height: 2.5rem; margin-top: 0.4rem; overflow: visible; }
  .kpi--mid { border-left: 1px solid var(--line); padding-left: 1.5rem; }
  .kpi--mid p { font-size: 0.7rem; color: var(--ink-500); }
  .kpi--donut { justify-items: center; }
  .kpi--donut svg { width: 5rem; height: 5rem; margin: 0; }
  .arc { transition: stroke-dashoffset 1.1s var(--ease); transition-delay: var(--d, 0ms); }
  .is-on .arc { stroke-dashoffset: var(--off); }

  .seals { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; margin-top: 1.5rem; font-size: var(--fs-small); font-weight: 500; color: var(--ink-600); }
  .seals li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .seals :global(svg) { color: var(--blue); flex: none; }

  @media (prefers-reduced-motion: reduce) { .is-on .flow, .is-on .palette__ring { animation: none; } .palette__ring { opacity: 0; } .chk__vals s { opacity: 1; } }
</style>
