---
/** App Store / Google Play badges drawn inline (black pill), so they are crisp and zero requests. */
interface Props { class?: string; size?: 'sm' | 'md'; theme?: 'dark' | 'light' }
const { class: cls = '', size = 'md', theme = 'dark' } = Astro.props;
---
<div class={`badges badges--${size} badges--${theme} ${cls}`} role="group" aria-label="Disponível nas lojas de aplicativos">
  <span class="badge" role="img" aria-label="Disponível na App Store">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.7c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1.9-4 2.4-1.7 2.9-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.3 1.3-2.6 1.3-2.7 0 0-2.6-1-2.6-3.9ZM14 5.5c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.8-1.5Z"/></svg>
    <span><small>Disponível na</small><strong>App Store</strong></span>
  </span>
  <span class="badge" role="img" aria-label="Disponível no Google Play">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path fill="#00D7FE" d="M3.6 2.4c-.3.3-.5.8-.5 1.4v16.4c0 .6.2 1.1.5 1.4l9.2-9.6-9.2-9.6Z"/>
      <path fill="#00F076" d="m15.9 15.1-3.1-3.1-9.2 9.6c.5.5 1.3.5 2.2 0l10.1-6.5Z"/>
      <path fill="#FFC900" d="m20 9.7-3.1-1.8-3 3.1 3.1 3.1 3-1.8c1.4-.8 1.4-1.9 0-2.6Z"/>
      <path fill="#F43249" d="M5.8 2.4 15.9 8.9l-3.1 3.1L3.6 2.4c.5-.5 1.3-.5 2.2 0Z"/>
    </svg>
    <span><small>Disponível no</small><strong>Google Play</strong></span>
  </span>
</div>

<style>
  .badges { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .badge {
    display: inline-flex; align-items: center; gap: 0.55rem; height: 2.75rem; padding: 0 0.9rem 0 0.7rem;
    border-radius: 6px; background: var(--ink); color: #fff; border: 1px solid rgb(255 255 255 / 0.12);
    line-height: 1; white-space: nowrap;
  }
  .badges--light .badge { background: #fff; color: var(--ink); border-color: var(--line-strong); }
  .badge svg { width: 1.45rem; height: 1.45rem; flex: none; }
  .badge small { display: block; font-size: 0.6rem; font-weight: 400; opacity: 0.8; letter-spacing: 0.01em; margin-bottom: 0.15rem; }
  .badge strong { display: block; font-size: 0.95rem; font-weight: 600; letter-spacing: -0.01em; }
  .badges--sm .badge { height: 2.25rem; padding-inline: 0.7rem 0.75rem; gap: 0.45rem; }
  .badges--sm .badge svg { width: 1.1rem; height: 1.1rem; }
  .badges--sm .badge small { font-size: 0.5rem; }
  .badges--sm .badge strong { font-size: 0.78rem; }
</style>
