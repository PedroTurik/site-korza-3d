---
import { pricing } from '../data/content';
import Icon from './Icon.astro';
---
<section class="price section" id="planos" aria-labelledby="price-title">
  <div class="container">
    <div class="price__head">
      <div class="section-head">
        <p class="eyebrow" data-reveal>{pricing.eyebrow}</p>
        <h2 class="h2" id="price-title" data-reveal style="--d:60ms">{pricing.h2a} <span class="accent">{pricing.h2b}</span></h2>
      </div>
      <p class="lead" data-reveal style="--d:120ms">{pricing.sub}</p>
    </div>
    <div class="plans">
      {pricing.plans.map((p, i) => (
        <article class={`plan ${p.soon ? 'plan--soon' : 'plan--main'}`} data-reveal style={`--d:${i * 100}ms`} aria-labelledby={`plan-${p.id}`}>
          <header class="plan__head">
            <div class="plan__row"><h3 class="plan__name" id={`plan-${p.id}`}>{p.name}</h3><span class={`tag ${p.soon ? 'tag--ink' : 'tag--soft'}`}>{p.badge}</span></div>
            <p class="plan__price"><span class="cur">R$</span><span class="val">{p.price}</span><span class="per">/mês</span></p>
            <p class="plan__desc">{p.desc}</p>
          </header>
          <ul class="plan__list">
            {p.features.map((f) => <li><Icon name="check" size={16} />{f}</li>)}
          </ul>
          <footer class="plan__foot">
            <a class={`btn btn--lg ${p.soon ? 'btn--ghost' : 'btn--primary'}`} href={p.ctaHref}>{p.cta}{!p.soon && <Icon name="arrow" class="arrow" />}</a>
            <p class="plan__note small muted">{p.note}</p>
          </footer>
        </article>
      ))}
    </div>
    <ul class="price__notes" data-reveal>
      {pricing.footnotes.map((n) => <li>{n}</li>)}
    </ul>
  </div>
</section>

<style>
  .price__head { display: grid; gap: 1.5rem; align-items: end; }
  @media (min-width: 64em) { .price__head { grid-template-columns: 1.2fr 0.8fr; gap: 4rem; } .price__head .lead { max-width: 24rem; justify-self: end; } }
  .plans { display: grid; gap: 1px; margin-top: 3.5rem; background: var(--line); border-top: 1px solid var(--line); }
  @media (min-width: 56em) { .plans { grid-template-columns: 1fr 1fr; } }
  .plan { display: grid; grid-template-rows: auto 1fr auto; gap: 2rem; padding: clamp(1.75rem, 3vw, 3rem) clamp(1.5rem, 3vw, 3rem) clamp(1.75rem, 3vw, 3rem) 0; background: #fff; position: relative; }
  @media (min-width: 56em) { .plan--soon { padding-left: clamp(1.5rem, 3vw, 3rem); padding-right: 0; } }
  .plan::before { content: ''; position: absolute; top: -1px; left: 0; width: 100%; height: 3px; background: var(--blue); }
  @media (min-width: 56em) { .plan--main::before { width: calc(100% - clamp(1.5rem, 3vw, 3rem)); } .plan--soon::before { left: clamp(1.5rem, 3vw, 3rem); width: calc(100% - clamp(1.5rem, 3vw, 3rem)); } }
  .plan--soon::before { background: var(--ink); }
  .plan__head { display: grid; gap: 1rem; }
  .plan__row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .plan__name { font-size: 1.5rem; font-weight: 500; letter-spacing: var(--track-snug); }
  .plan__price { display: flex; align-items: baseline; gap: 0.3rem; }
  .plan__price .cur { font-weight: 500; font-size: 1.25rem; color: var(--ink-500); }
  .plan__price .val { font-size: clamp(3.5rem, 2.5rem + 3vw, 5rem); font-weight: 500; line-height: 1; letter-spacing: var(--track); }
  .plan__price .per { color: var(--ink-500); }
  .plan__desc { color: var(--ink-600); max-width: 26rem; }
  .plan__list { display: grid; gap: 0.75rem; align-content: start; }
  .plan__list li { display: flex; gap: 0.65rem; align-items: flex-start; font-size: 0.95rem; color: var(--ink-600); }
  .plan__list :global(svg) { color: var(--blue); flex: none; margin-top: 0.3rem; }
  .plan--soon .plan__list :global(svg) { color: var(--ink-400); }
  .plan__foot { display: grid; gap: 0.75rem; justify-items: start; }
  .price__notes { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin-top: 2rem; font-size: var(--fs-small); color: var(--ink-500); }
  .price__notes li::before { content: '—'; margin-right: 0.5rem; color: var(--blue); }
</style>
