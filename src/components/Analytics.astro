---
/**
 * GA4 with Consent Mode v2. Analytics storage starts DENIED (LGPD); the small banner grants or refuses.
 * Choice is remembered in localStorage. gtag is loaded only after the page is idle so it never blocks LCP.
 */
const GA_ID = 'G-8HJQLPS6DE';
---
<div class="consent" id="consent" hidden role="dialog" aria-live="polite" aria-label="Aviso de cookies">
  <p>Cookies de analytics, só para entender o uso do site. <a href="/privacidade">Privacidade</a></p>
  <div class="consent__actions">
    <button type="button" class="btn btn--ghost btn--sm" data-consent="denied">Recusar</button>
    <button type="button" class="btn btn--ink btn--sm" data-consent="granted">Aceitar</button>
  </div>
</div>

<script is:inline define:vars={{ GA_ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }
  window.gtag = gtag;
  var KEY = 'korza:consent';
  var saved = null; try { saved = localStorage.getItem(KEY); } catch (e) {}
  gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: saved === 'granted' ? 'granted' : 'denied', wait_for_update: 500 });
  gtag('js', new Date());
  gtag('config', GA_ID, { anonymize_ip: true, send_page_view: true });
  var load = function () {
    if (document.getElementById('ga4')) return;
    var s = document.createElement('script'); s.id = 'ga4'; s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID; document.head.appendChild(s);
  };
  var idle = window.requestIdleCallback || function (cb) { setTimeout(cb, 1500); };
  window.addEventListener('load', function () { idle(load); });
  var box = document.getElementById('consent');
  if (!saved && box) { setTimeout(function () { box.hidden = false; }, 1600); }
  box && box.addEventListener('click', function (e) {
    var b = e.target.closest('[data-consent]'); if (!b) return;
    var v = b.getAttribute('data-consent');
    try { localStorage.setItem(KEY, v); } catch (e2) {}
    gtag('consent', 'update', { analytics_storage: v });
    box.hidden = true;
  });
  // outbound CTA tracking
  document.addEventListener('click', function (e) {
    var a = e.target.closest('a[href^="https://admin.korza.app"]'); if (!a) return;
    gtag('event', 'cta_click', { link_url: a.href, link_text: (a.textContent || '').trim().slice(0, 60) });
  });
</script>

<style>
  .consent {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem;
    padding: 0.55rem 0.75rem 0.55rem 0.9rem; background: #fff; border-top: 1px solid var(--line);
    font-size: var(--fs-xs); line-height: 1.35; color: var(--ink-600); animation: consent-in 0.6s var(--ease) both;
  }
  .consent[hidden] { display: none; }
  .consent p { flex: 1 1 12rem; }
  .consent a { text-decoration: underline; text-underline-offset: 2px; color: var(--ink); }
  .consent__actions { display: flex; gap: 0.4rem; }
  .consent__actions .btn--sm { min-height: 2.1rem; padding: 0 0.7rem; font-size: 0.78rem; }
  @media (min-width: 48em) {
    .consent {
      left: 1rem; right: auto; bottom: 1rem; max-width: 30rem; flex-wrap: nowrap;
      padding: 0.45rem 0.45rem 0.45rem 1rem; border: 1px solid var(--line-strong); border-radius: 999px; box-shadow: var(--shadow-lg);
    }
    .consent p { white-space: nowrap; }
  }
  @keyframes consent-in { from { opacity: 0; transform: translateY(8px); } }
  @media (prefers-reduced-motion: reduce) { .consent { animation: none; } }
</style>
